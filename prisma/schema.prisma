// BimehMasooliyat.ir — Data Model
// Single-product platform: فقط بیمه مسئولیت.
// NOTE: محتوای سایت (محصولات، مقالات، FAQ و…) استاتیک از prisma/seed-data سرو می‌شود
// (src/lib/data.ts). دیتابیس فقط داده‌های کاربر را نگه می‌دارد:
// QuoteRequest | ContactMessage | NewsletterSubscriber | Review
// مدل‌های محتوایی صرفاً برای سازگاری با تاریخچه و اسکریپت seed حفظ شده‌اند.
// array fields به‌صورت Json ذخیره می‌شوند (primitive list مجاز نیست).

generator client {
  provider = "prisma-client-js"
  // rhel-openssl-3.0.x برای runtime توابع serverless روی Vercel (Amazon Linux) لازم است
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Content: Categories & Products ────────────────────────────────

model LiabilityCategory {
  id            String             @id @default(cuid())
  key           String             @unique // professional | commercial | corporate | public
  nameFa        String
  nameEn        String
  descriptionFa String
  icon          String? // lucide icon name
  order         Int                @default(0)
  products      LiabilityProduct[]
}

model LiabilityProduct {
  id             String   @id @default(cuid())
  slug           String   @unique // e.g. "medical-doctors"
  categoryKey    String
  category       LiabilityCategory @relation(fields: [categoryKey], references: [key])
  nameFa         String // بیمه مسئولیت پزشکان
  nameEn         String // Physicians Professional Liability Insurance
  audienceFa     String // مخاطب مستقیم
  summaryFa      String // ۱ جمله برای کارت‌ها
  answerBlock    String // 40-60 words — AI-citation ready
  whoCovered     Json // string[]
  coverages      Json // {title, description}[]
  exclusions     Json // string[]
  conditions     Json // string[]
  documents      Json // string[]
  buySteps       Json // {title, description}[]
  claimSteps     Json // {title, description}[]
  legalSources   Json // {title, reference}[]
  keywords       Json // string[]
  seoTitle       String
  seoDescription String
  priceFromFa    String? // «از ۲٫۵ میلیون تومان در سال» (نمایشی — نهایی پس از استعلام)
  phase          Int      @default(2) // 1 = MVP
  featured       Boolean  @default(false)
  reviewDate     String // ISO date — آخرین بازبینی تخصصی
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ─── FAQ (global + per-product) ────────────────────────────────────

model Faq {
  id          String  @id @default(cuid())
  question    String
  answer      String // 40-60 words
  productSlug String? // null → global FAQ
  group       String? // definition | coverage | price | claim | compare
  order       Int     @default(0)
}

// ─── Local SEO: Cities ─────────────────────────────────────────────

model City {
  id           String   @id @default(cuid())
  slug         String   @unique
  nameFa       String
  province     String
  intro        String // محتوای منحصربه‌فرد شهری (۶۰–۹۰ کلمه)
  industries   Json // string[] — صنایع غالب → محصولات مرتبط
  productSlugs Json // string[] — محصولات مرتبط با این شهر
  faqs         Json // {question, answer}[]
  order        Int      @default(0)
}

// ─── Transactions ──────────────────────────────────────────────────

model QuoteRequest {
  id              String   @id @default(cuid())
  trackingCode    String   @unique // Q-YYMMDD-XXXX
  fullName        String
  phone           String
  city            String?
  productSlug     String?
  productName     String?
  desiredCoverage String? // سقف تقریبی تعهد
  message         String?
  source          String   @default("website") // website | whatsapp | phone
  status          String   @default("new") // new | contacted | quoted | won | lost
  ipHash          String? // sha256 — بدون ذخیره IP خام
  createdAt       DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  phone     String?
  email     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

// ─── سفارش‌های محاسبه‌شده آنلاین (ثبت خرید) ─────────────────────────

model InsuranceOrder {
  id            String   @id @default(cuid())
  trackingCode  String   @unique // O-YYMMDD-XXXX
  kind          String // doctors | nurses | engineers
  productSlug   String
  productName   String
  config        Json // تمام گزینه‌های انتخابی محاسبه
  breakdown     Json // صورت‌حساب: نرخ پایه، پوشش‌ها، تخفیف، نهایی
  totalToman    Int // قیمت نهایی محاسبه‌شده (تومان/سال)
  fullName      String
  nationalId    String?
  phone         String
  email         String?
  city          String?
  postalCode    String?
  birthYear     Int?
  licenseNumber String? // نظام پزشکی / نظام پرستاری / نظام مهندسی
  workAddress   String?
  prevPolicyNumber String? // شماره بیمه‌نامه سال قبل (تخفیف عدم خسارت)
  note          String?
  status        String   @default("new") // new | verifying | issued | rejected
  ipHash        String?
  createdAt     DateTime @default(now())
}

// ─── Content: Blog / Knowledge ─────────────────────────────────────

model Article {
  id                 String   @id @default(cuid())
  slug               String   @unique
  title              String
  excerpt            String
  sections           Json // {heading, body, list?, table?}[]
  faqs               Json // {question, answer}[]
  keywords           Json // string[]
  seoTitle           String
  seoDescription     String
  readMinutes        Int
  relatedProductSlug String?
  authorSlug         String
  reviewDate         String
  publishedAt        DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ─── E-E-A-T ───────────────────────────────────────────────────────

model Author {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  roleFa      String
  bio         String
  credentials Json // string[]
  order       Int    @default(0)
}

model LegalSource {
  id          String @id @default(cuid())
  title       String
  reference   String // ماده/بند
  description String
  order       Int    @default(0)
}

// ─── Glossary (واژه‌نامه تخصصی بیمه مسئولیت) ────────────────────────

model GlossaryTerm {
  id              String @id @default(cuid())
  slug            String @unique
  title           String
  category        String // base | legal | coverage | claim | market
  short           String // ۱۵-۲۵ کلمه — کارت + متا
  body            String // ۱۰۰-۱۸۰ کلمه — پاسخ اول قابل استناد
  related         Json // string[] — slug واژه‌های مرتبط
  relatedProducts Json? // string[] — slug محصولات مرتبط
  order           Int    @default(0)
}

// ─── Newsletter ────────────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  ipHash    String?
  createdAt DateTime @default(now())
}

// ─── Reviews (فقط نظرات واقعی — انتشار پس از تأیید، بدون رِیتینگ جعلی) ──

model Review {
  id         String   @id @default(cuid())
  name       String
  city       String?
  productSlug String?
  rating     Int // 1-5
  text       String
  status     String   @default("pending") // pending | approved | rejected
  ipHash     String?
  createdAt  DateTime @default(now())
}
